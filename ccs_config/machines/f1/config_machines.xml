   <machine MACH="f1">
    <DESC>f1</DESC>
    <OS>LINUX</OS>
    <COMPILERS>intel</COMPILERS>
    <MPILIBS>impi</MPILIBS>
    <PROJECT>MST111414</PROJECT>
    <CIME_OUTPUT_ROOT>/work1/$ENV{USER}/cesm2_work/cases</CIME_OUTPUT_ROOT>
